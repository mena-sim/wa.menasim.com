[Unit]
Description=Menasim WA Support (FastAPI / gunicorn + uvicorn workers)
After=network.target mysqld.service mysql.service

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wamena
Environment=PATH=/www/wamena/.venv/bin
ExecStart=/www/wamena/.venv/bin/gunicorn app.main:app --workers 2 --worker-class uvicorn.workers.UvicornWorker --bind 127.0.0.1:8000 --chdir /www/wamena
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
