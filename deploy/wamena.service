[Unit]
Description=Menasim WA Support (FastAPI / uvicorn)
After=network.target mysqld.service mysql.service

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wamena
Environment=PATH=/www/wamena/.venv/bin
ExecStart=/www/wamena/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
