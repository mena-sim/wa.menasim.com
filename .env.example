# ---- LLM (DeepSeek, OpenAI-compatible) ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- App ----
APP_NAME=menasim WA support
# Local/dev default is SQLite. For production (aaPanel) use MySQL with PyMySQL, e.g.:
#   DATABASE_URL=mysql+pymysql://wa_menasim:PASSWORD@127.0.0.1:3306/wa_menasim?charset=utf8mb4
DATABASE_URL=sqlite:///./data/app.db
CHROMA_DIR=./data/chroma
PUBLIC_BASE_URL=http://127.0.0.1:8080
LOG_LEVEL=INFO

# ---- Admin console (React app at /admin) ----
# Password to sign in to the admin console. CHANGE THIS.
ADMIN_PASSWORD=admin
# Fernet key used to encrypt secrets saved from the admin. Leave blank to
# auto-generate one at data/secret.key on first run.
ENCRYPTION_KEY=

# Agent guardrails
AGENT_MAX_TOOL_ITERS=6
AGENT_MAX_TOKENS=1024
RATE_LIMIT_PER_MINUTE=20

# ---- WooCommerce / WordPress ----
WC_BASE_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
# Comma-separated order meta keys that may hold eSIM data (plugin dependent)
WC_ESIM_ICCID_META=iccid,_iccid,esim_iccid
WC_ESIM_QR_META=qr,qr_code,esim_qr,activation_code
WC_ESIM_STATUS_META=esim_status,status

# ---- Telnyx WhatsApp (production; leave blank for local web testing) ----
TELNYX_API_KEY=
TELNYX_WHATSAPP_FROM=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_WEBHOOK_PUBLIC_KEY=

# ---- Escalation email alerts (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=
